<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="#2A1A10">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="stardew3ds converter" android:textSize="22sp" android:textStyle="bold"
        android:textColor="#FFE8B0" android:layout_marginBottom="4dp" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#E0C8A0" android:textSize="13sp" android:layout_marginBottom="10dp" />

    <!-- 1. your files -->
    <TextView style="@style/Label" android:text="1. Your game files" />
    <LinearLayout style="@style/Row">
        <Button android:id="@+id/pickContent" style="@style/Btn" android:text="Content folder" />
        <Button android:id="@+id/pickContentZip" style="@style/Small" android:layout_width="56dp" android:text="zip" />
        <TextView android:id="@+id/contentName" style="@style/Value" />
    </LinearLayout>
    <LinearLayout style="@style/Row">
        <Button android:id="@+id/pickMods" style="@style/Btn" android:text="Mods folder" />
        <Button android:id="@+id/pickModZips" style="@style/Small" android:layout_width="56dp" android:text="zips" />
        <TextView android:id="@+id/modsName" style="@style/Value" />
        <Button android:id="@+id/clearMods" style="@style/Small" android:text="x" />
    </LinearLayout>
    <LinearLayout style="@style/Row">
        <Button android:id="@+id/pickLogo" style="@style/Btn" android:text="Your logo" />
        <TextView android:id="@+id/logoName" style="@style/Value" />
        <Button android:id="@+id/clearLogo" style="@style/Small" android:text="x" />
    </LinearLayout>

    <!-- 2. convert -->
    <TextView style="@style/Label" android:text="2. Convert" />
    <Button android:id="@+id/convert" style="@style/Big" android:text="Convert" />

    <!-- 3. get it onto the 3DS -->
    <TextView style="@style/Label" android:text="3. Put it on your 3DS" />
    <Button android:id="@+id/saveTo" style="@style/Big" android:text="Save to a folder / SD card" />
    <LinearLayout style="@style/Row">
        <EditText android:id="@+id/ip" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:hint="3DS IP (from ftpd)"
            android:inputType="text" android:textColor="#FFE8B0" android:textColorHint="#8A7050" />
        <EditText android:id="@+id/port" android:layout_width="80dp" android:layout_height="wrap_content"
            android:hint="port" android:inputType="number" android:textColor="#FFE8B0" android:textColorHint="#8A7050" />
        <Button android:id="@+id/send" style="@style/Btn" android:text="Send" />
    </LinearLayout>

    <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="8dp" android:background="#1A100A" android:padding="6dp">
        <TextView android:id="@+id/log" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#D8E8C8" android:textSize="11sp" android:fontFamily="monospace" android:textIsSelectable="true" />
    </ScrollView>
</LinearLayout>
